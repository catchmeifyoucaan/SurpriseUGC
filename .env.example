# ViralForge.ai Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=ViralForge.ai
APP_VERSION=1.0.0
ENVIRONMENT=development  # development, staging, production
DEBUG=true

# =============================================================================
# SECURITY (CRITICAL - CHANGE IN PRODUCTION!)
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_IN_PRODUCTION

# JWT Token Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=11520  # 8 days
REFRESH_TOKEN_EXPIRE_DAYS=30

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://viralforge_user:your_secure_password@localhost:5432/viralforge

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# AI SERVICE API KEYS
# =============================================================================
# OpenAI (GPT-4 for script generation, DALL-E for images)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic Claude (Advanced content optimization)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ElevenLabs (Voice synthesis)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# HeyGen (Avatar animation)
HEYGEN_API_KEY=your-heygen-api-key-here

# Google AI (Gemini, future Veo3 integration)
GOOGLE_AI_API_KEY=your-google-ai-api-key-here

# Kling AI (KWEN3 video generation)
KLING_API_KEY=your-kling-api-key-here

# Replicate (Open source models)
REPLICATE_API_KEY=your-replicate-api-key-here

# =============================================================================
# EXTERNAL APIS
# =============================================================================
# SerpAPI (Web search and research)
SERPAPI_KEY=your-serpapi-key-here

# Twitter/X API
TWITTER_BEARER_TOKEN=your-twitter-bearer-token-here

# Reddit API
REDDIT_CLIENT_ID=your-reddit-client-id-here
REDDIT_CLIENT_SECRET=your-reddit-client-secret-here

# =============================================================================
# CLOUD STORAGE (AWS S3)
# =============================================================================
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET=viralforge-videos
S3_REGION=us-east-1
CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

# =============================================================================
# PAYMENTS (STRIPE)
# =============================================================================
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Stripe Price IDs (from Stripe Dashboard)
STRIPE_PRICE_ID_STARTER=price_starter_monthly
STRIPE_PRICE_ID_PRO=price_pro_monthly
STRIPE_PRICE_ID_ENTERPRISE=price_enterprise_monthly

# =============================================================================
# MONITORING & ERROR TRACKING
# =============================================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# =============================================================================
# EMAIL SERVICE (SMTP)
# =============================================================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
SMTP_TLS=true
EMAILS_FROM_EMAIL=noreply@viralforge.ai
EMAILS_FROM_NAME=ViralForge.ai

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
BACKEND_CORS_ORIGINS=http://localhost:3000,https://viralforge.ai,https://www.viralforge.ai

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_AI_AGENTS=true
ENABLE_BULK_GENERATION=true
ENABLE_CUSTOM_AVATARS=true
ENABLE_ANALYTICS=true

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# =============================================================================
# VIDEO GENERATION SETTINGS
# =============================================================================
MAX_VIDEO_DURATION=60
MAX_BULK_VARIANTS=100
VIDEO_QUALITY=1080p
DEFAULT_AVATAR_COUNT=1000
CUSTOM_AVATAR_TRAINING_TIME=3600

# =============================================================================
# OAUTH (OPTIONAL - FOR SOCIAL LOGIN)
# =============================================================================
# Auth0 Configuration
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
